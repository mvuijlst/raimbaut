{
  "name": "raimbaut-edition",
  "version": "0.1.0",
  "description": "Web edition of the 1981 thesis on the troubadour Raimbaut d'Orange",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && eleventy && pagefind --site _site",
    "serve": "eleventy --serve",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true,maxRetries:10,retryDelay:150})\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-bracketed-spans": "^1.0.1",
    "pagefind": "^1.5.2"
  }
}
